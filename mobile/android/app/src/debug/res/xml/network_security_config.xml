<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config. Lives in src/debug, so it is never
  merged into a release build — see src/debug/AndroidManifest.xml, which
  references this file via android:networkSecurityConfig.

  Why this exists: mobile/src/chain/api.ts's NODE_WS_URL points at a local
  `‑‑dev` chain node over plain ws://, not wss://. Android blocks cleartext
  (unencrypted) traffic by default from targetSdkVersion 28+ (this app
  targets 34, see android/build.gradle), so without an exception a debug
  build cannot open that WebSocket at all and fails with "CLEARTEXT
  communication ... not permitted".

  This grants cleartext only to the specific hosts a dev node is actually
  reached at, instead of a blanket android:usesCleartextTraffic="true"
  (which would permit cleartext to ANY host the app talks to):
    - 10.0.2.2            the Android emulator's documented alias for the
                           host machine's loopback interface — the default
                           NODE_WS_URL target (AVD-only address).
    - localhost / 127.0.0.1  a physical device reached via
                           `adb reverse tcp:9944 tcp:9944`, forwarding the
                           device's own localhost:9944 to the dev machine's
                           node. This is the realistic way to exercise this
                           app's core feature (NFC passport scanning), since
                           emulators have no NFC hardware.

  A release build must point at a real chain over wss:// and ships with no
  cleartext exception at all (see ../../main/AndroidManifest.xml, which has
  no networkSecurityConfig / usesCleartextTraffic attribute).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Everything else stays at the platform default (no cleartext).
         Spelled out explicitly rather than left implicit. -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
