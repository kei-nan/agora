{
  "name": "agora-committee",
  "version": "0.1.0",
  "private": true,
  "description": "OPRF committee-duty app — deliberately separate from agora-mobile (see docs/project/changelog/082.md) so the OPRF secret-key material never shares an attack surface with the general-purpose citizen app. Same @polkadot/api chain-integration conventions as mobile/, own package/build/test graph.",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@polkadot/api": "^12.0.0",
    "@polkadot/keyring": "^13.0.0",
    "@polkadot/util": "^13.0.0",
    "@polkadot/util-crypto": "^13.0.0",
    "@polkadot/wasm-crypto-asmjs": "^7.3.2",
    "buffer": "^6.0.3",
    "fast-text-encoding": "^1.0.6",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-safe-area-context": "^4.10.0"
  },
  "overrides": {
    "jest-environment-node": "^30.4.1",
    "jest-mock": "^30.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.74.0",
    "@react-native/eslint-config": "0.74.0",
    "@react-native/typescript-config": "0.74.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.6",
    "babel-jest": "^30.4.1",
    "eslint": "^8.19.0",
    "jest": "^30.4.2",
    "typescript": "5.0.4"
  }
}
